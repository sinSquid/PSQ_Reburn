--- /dev/null
+++ b/BodyChangeNG-PSQ/scripts/Test-PackageRelease.ps1
@@ -0,0 +1,75 @@
+#requires -Version 7.0
+param(
+    [Parameter(Mandatory)][string]$BuiltDll,
+    [Parameter(Mandatory)][string]$BuiltCacheTool
+)
+$ErrorActionPreference = 'Stop'
+$project = [IO.Path]::GetFullPath((Split-Path -Parent $PSScriptRoot))
+$dll = (Resolve-Path -LiteralPath $BuiltDll).Path
+$cache = (Resolve-Path -LiteralPath $BuiltCacheTool).Path
+$config = Get-Content -LiteralPath (Join-Path $project 'xmake.lua') -Raw
+if ($config -notmatch 'local psqBridgeVersion = "(\d+\.\d+\.\d+\.\d+)"') {
+    throw 'Missing PSQ bridge release version.'
+}
+$version = $Matches[1]
+if ((Get-Item -LiteralPath $dll).VersionInfo.FileVersion -ne $version) {
+    throw 'The regression requires a real DLL with the configured resource version.'
+}
+$fixture = Join-Path ([IO.Path]::GetTempPath()) ('PSQ-package-regression-' + [Guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $fixture | Out-Null
+# No source checkout, game folder or existing release is a test destination.
+foreach ($item in Get-ChildItem -LiteralPath $project -Force) {
+    if ($item.Name -notin '.git', '.xmake', 'build', 'release', 'package') {
+        Copy-Item -LiteralPath $item.FullName -Destination $fixture -Recurse
+    }
+}
+$binaryDirectory = Join-Path $fixture "build/v$version/windows/x64/release"
+$toolDirectory = Join-Path $fixture "build/v$version/tools"
+New-Item -ItemType Directory -Path $binaryDirectory, $toolDirectory | Out-Null
+Copy-Item -LiteralPath $dll -Destination (Join-Path $binaryDirectory 'BodyChangeNG.dll')
+Copy-Item -LiteralPath $cache -Destination (Join-Path $toolDirectory 'BodyChangeNGCache.exe')
+
+# The PSQ source archive intentionally omits the upstream standalone package.
+# Synthetic guides/rules test archive assembly only; they are never a mod release.
+$package = Join-Path $fixture 'package'
+foreach ($relative in @(
+    'BodySkin/README.txt',
+    'CalienteTools/BodySlide/SliderPresets/README.txt',
+    'Futanari/README.txt',
+    'SKSE/Plugins/BodyChangeNGdistribution-README.txt',
+    'Tools/BodyChangeNG-RuleId.ps1',
+    'Tools/BodyChangeNGCache-README.txt'
+)) {
+    $file = Join-Path $package $relative
+    New-Item -ItemType Directory -Path (Split-Path -Parent $file) -Force | Out-Null
+    [IO.File]::WriteAllText($file, 'Regression fixture only; not a mod release.')
+}
+[IO.File]::WriteAllText((Join-Path $package 'SKSE/Plugins/BodyChangeNGdistribution.json'), '{"schemaVersion":8,"rules":[]}')
+
+& git -C $fixture init -b codex/package-regression | Out-Null
+if ($LASTEXITCODE) { throw 'Fixture git init failed.' }
+& git -C $fixture config user.name 'PSQ offline regression'
+if ($LASTEXITCODE) { throw 'Fixture git configuration failed.' }
+& git -C $fixture config user.email 'psq-regression@tests.invalid'
+if ($LASTEXITCODE) { throw 'Fixture git configuration failed.' }
+& git -C $fixture config core.autocrlf false
+if ($LASTEXITCODE) { throw 'Fixture git configuration failed.' }
+& git -C $fixture add --all
+if ($LASTEXITCODE) { throw 'Fixture git add failed.' }
+& git -C $fixture -c core.hooksPath=NUL commit -q -m 'Isolated package regression inputs'
+if ($LASTEXITCODE) { throw 'Fixture git commit failed.' }
+& (Join-Path $fixture 'scripts/Package-Release.ps1') -RepositoryRoot $fixture
+$binaryZip = Join-Path $fixture "release/Body Change NG v$version.zip"
+$sourceZip = Join-Path $fixture "release/Body Change NG v$version Source.zip"
+if (!(Test-Path -LiteralPath $binaryZip) -or !(Test-Path -LiteralPath $sourceZip)) {
+    throw 'The release entry point did not produce both verified archives.'
+}
+[pscustomobject]@{
+    Passed = $true
+    Version = $version
+    Fixture = $fixture
+    BinaryArchive = $binaryZip
+    SourceArchive = $sourceZip
+    GameRuntimeTested = $false
+    SyntheticStandalonePackage = $true
+} | ConvertTo-Json -Compress
