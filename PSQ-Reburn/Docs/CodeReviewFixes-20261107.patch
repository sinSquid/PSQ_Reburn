+namespace ui {
+void Notify(const std::string&) {}
+const char* Localize(const char*, const char* english, const char*) { return english; }
+}
+struct Settings {
+    struct Values { input::HotkeyChord openHotkey; } values;
+    unsigned saves{};
+    static Settings& Get() { static Settings settings; return settings; }
+    Values Snapshot() const { return values; }
+    void Update(Values next) { values=next; }
+    bool Save() { ++saves; return true; }
+};
+class InputSink {
+public:
+    static InputSink& Get() { static InputSink sink; return sink; }
+    void BeginHotkeyCapture();
+    void CancelHotkeyCapture();
+    void ResetTransientState();
+    bool IsCapturingHotkey() const noexcept;
+    void ProcessHotkeyCaptureButton(const RE::ButtonEvent&);
+    void ObserveKeyboardButton(const RE::ButtonEvent&);
+    void QueueHotkeyCaptureRelease(std::uint32_t, std::size_t);
+    void FinishHotkeyCaptureReleases();
+    RE::BSEventNotifyControl ProcessEvent(RE::InputEvent* const*, RE::BSTEventSource<RE::InputEvent*>*);
+private:
+    void ProcessKeyboardButton(const RE::ButtonEvent&);
+    void RetireHotkeyCaptureReleases(std::size_t);
+    void RequestToggle(std::string_view) { ++native_ui::toggles; }
+    bool CtrlDown() const noexcept;
+    bool ShiftDown() const noexcept;
+    bool AltDown() const noexcept;
+    mutable std::mutex lock_;
+    std::unordered_set<unsigned> heldKeys_;
+    std::vector<std::pair<std::size_t,std::uint32_t>> captureReleases_;
+    std::atomic_bool capture_{};
+};
+}
+namespace {
+constexpr unsigned kEscape=1;
+constexpr std::array kCtrl{0x1DU,0x9DU}, kShift{0x2AU,0x36U}, kAlt{0x38U,0xB8U};
+bool Contains(const std::unordered_set<unsigned>& keys, const std::array<unsigned,2>& candidates) {
+    return std::ranges::any_of(candidates,[&](auto key){return keys.contains(key);});
+}
+}
+#include "capture_input_production.inc"
+namespace {
+#include "capture_filter_production.inc"
+unsigned checks{};
+bool dispatchToSink{true};
+void Dispatch(RE::BSTEventSource<RE::InputEvent*>*, RE::InputEvent** head) {
+    if(dispatchToSink&&head&&*head) bcn::InputSink::Get().ProcessEvent(head,nullptr);
+}
+void Check(bool value, const char* message) { ++checks; if(!value) throw std::runtime_error(message); }
+void Reset() {
+    ResetLocked(); bcn::InputSink::Get().ResetTransientState();
+    bcn::Settings::Get()={}; RE::UI::console=false;
+    bcn::native_ui::open=true; bcn::native_ui::typing=false;
+    bcn::native_ui::textEvents=bcn::native_ui::navigationEvents=bcn::native_ui::actions=bcn::native_ui::escapes=bcn::native_ui::toggles=0;
+    g_originalPollInputDevices.callback=&Dispatch; dispatchToSink=true;
+}
+bool Key(unsigned id, int edge) {
+    RE::ButtonEvent event; event.id=id; event.edge=edge;
+    RE::InputEvent* head=&event; HookedPollInputDevices(nullptr,&head);
+    return head!=nullptr;
+}
+void Batch(RE::InputEvent* head, bool filtered) {
+    if(filtered) HookedPollInputDevices(nullptr,&head);
+    else if(head) bcn::InputSink::Get().ProcessEvent(&head,nullptr);
+}
+}
+int main() try {
+    auto& sink=bcn::InputSink::Get(); auto& settings=bcn::Settings::Get();
+    for(auto key:{0x11U,0x1EU,0x1FU,0x20U,0x1CU,0x9CU,0xC8U,0xCBU,0xCDU,0xD0U,0x41U}) {
+        for(bool typing:{false,true}) {
+            Reset(); bcn::native_ui::typing=typing; sink.BeginHotkeyCapture();
+            Check(!Key(key,0),"captured down leaked");
+            Check(!sink.IsCapturingHotkey()&&settings.values.openHotkey.key==key&&settings.saves==1,"capture did not reach real input sink");
+            Check(!Key(key,1),"captured hold leaked");
+            Check(!Key(key,2),"captured release leaked");
+            Check(bcn::native_ui::actions==0&&bcn::native_ui::toggles==0,"capture activated menu/game shortcut");
+            sink.BeginHotkeyCapture();
+            Check(!Key(key,0)&&settings.saves==2,"second capture retained stale held key");
+            bcn::native_ui::open=false; bcn::native_ui::typing=false;
+            sink.ResetTransientState();
+            Check(!Key(key,2),"release leaked after menu close");
+        }
+    }
+    Reset(); sink.BeginHotkeyCapture();
+    Key(0x1D,0); Key(0x2A,0); Key(0x38,0); Key(0x11,0);
+    Check(settings.values.openHotkey.ctrl&&settings.values.openHotkey.shift&&settings.values.openHotkey.alt,"modifier chord lost");
+    Key(0x11,2); Key(0x1D,2); Key(0x2A,2); Key(0x38,2);
+    sink.BeginHotkeyCapture(); Key(0x1E,0);
+    Check(!settings.values.openHotkey.ctrl&&!settings.values.openHotkey.shift&&!settings.values.openHotkey.alt,"modifier releases remained held");
+    Reset(); bcn::native_ui::open=false; Check(Key(0x11,0),"preheld press should reach game");
+    bcn::native_ui::open=true; sink.BeginHotkeyCapture(); Key(0x11,1);
+    Check(sink.IsCapturingHotkey()&&settings.saves==0,"held key captured without fresh down");
+    Check(Key(0x11,2),"preheld release did not reach original owner");
+    Check(!Key(0x11,0)&&settings.saves==1,"fresh press after preheld release failed");
+    Reset(); sink.BeginHotkeyCapture(); Key(1,0);
+    Check(!sink.IsCapturingHotkey()&&settings.saves==0&&bcn::native_ui::escapes==0,"Escape did not cancel private capture");
+    Check(!Key(1,2),"cancel release leaked");
+    Reset(); sink.BeginHotkeyCapture(); RE::UI::console=true;
+    Check(Key(0x11,0)&&Key(0x11,2)&&sink.IsCapturingHotkey()&&settings.saves==0,"console input was captured");
+    RE::UI::console=false; Key(0x11,0);
+    Check(settings.saves==1,"capture did not resume after console");
+    Reset(); bcn::native_ui::open=false; Key(0x1D,0);
+    RE::UI::console=true; Key(0x1D,2); RE::UI::console=false;
+    bcn::native_ui::open=true; sink.BeginHotkeyCapture(); Key(0x11,0);
+    Check(!settings.values.openHotkey.ctrl,"console-owned modifier release remained latched");
+    Reset(); sink.BeginHotkeyCapture();
+    RE::ButtonEvent first, second; first.id=0x11; second.id=0x1E; first.next=&second;
+    RE::InputEvent* batch=&first; FilterKeyboardEvents(&batch);
+    Check(batch==nullptr&&settings.saves==1&&settings.values.openHotkey.key==0x11,
+        "same-poll second key escaped or replaced first capture");
+    Check(!Key(0x11,2)&&!Key(0x1E,2),"same-poll releases escaped");
+    Reset(); sink.BeginHotkeyCapture(); sink.CancelHotkeyCapture(); Key(0x11,0);
+    Check(settings.saves==0,"cancelled capture still saved");
+    Reset(); sink.BeginHotkeyCapture(); Key(0x11,0);
+    Check(bcn::native_ui::textEvents==0,"capture event entered editable field");
+    // Filtering runs over the whole list before InputSink sees its first item.
+    // A normal modifier-up must not run ahead of a preceding shortcut-down.
+    for(bool open:{false,true}) {
+        for(bool filtered:{false,true}) {
+            Reset(); bcn::native_ui::open=open;
+            settings.values.openHotkey={.key=0x41,.ctrl=true};
+            Key(0x1D,0);
+            RE::ButtonEvent shortcut, release; shortcut.id=0x41;
+            release.id=0x1D; release.edge=2; shortcut.next=&release;
+            Batch(&shortcut,filtered);
+            Check(bcn::native_ui::toggles==1,"filter reordered ordinary modifier release ahead of shortcut");
+            Key(0x41,2); Key(0x41,0);
+            Check(bcn::native_ui::toggles==1,"normal modifier release was not retired by dispatcher");
+        }
+    }
+    // A release that really belongs to capture stays private after capture
+    // completes, even beside a later ordinary shortcut in the next poll.
+    Reset(); sink.BeginHotkeyCapture(); Key(0x1D,0); Key(0x11,0);
+    Key(0x11,2); settings.values.openHotkey={.key=0x41};
+    RE::ButtonEvent capturedModifierRelease, plainShortcut;
+    capturedModifierRelease.id=0x1D; capturedModifierRelease.edge=2;
+    plainShortcut.id=0x41; capturedModifierRelease.next=&plainShortcut;
+    RE::InputEvent* afterCapture=&capturedModifierRelease;
+    FilterKeyboardEvents(&afterCapture);
+    Check(afterCapture==&plainShortcut,"capture-owned modifier release leaked into normal dispatch");
+    Batch(afterCapture,false);
+    Check(bcn::native_ui::toggles==1,"capture modifier remained held into next poll");
+    // Captured modifier-ups retain their position before, between and after
+    // ordinary shortcuts, even though those ups are private to InputSink.
+    for(unsigned releasePosition=0; releasePosition<3; ++releasePosition) {
+        for(bool filtered:{false,true}) {
+            Reset(); sink.BeginHotkeyCapture(); Key(0x1D,0); Key(0x11,0); Key(0x11,2);
+            settings.values.openHotkey={.key=0x41,.ctrl=true};
+            RE::ButtonEvent before, ordinaryRelease, release, after;
+            before.id=0x41; ordinaryRelease.id=0x41; ordinaryRelease.edge=2;
+            release.id=0x1D; release.edge=2; after.id=0x41;
+            RE::InputEvent* head{};
+            if(releasePosition==0) { release.next=&before; head=&release; }
+            else if(releasePosition==1) { before.next=&ordinaryRelease; ordinaryRelease.next=&release; release.next=&after; head=&before; }
+            else { before.next=&ordinaryRelease; ordinaryRelease.next=&after; after.next=&release; head=&before; }
+            Batch(head,filtered);
+            Check(bcn::native_ui::toggles==releasePosition,"capture-owned release changed ordinary shortcut order");
+            Key(0x41,2); Key(0x41,0);
+            Check(bcn::native_ui::toggles==releasePosition,"captured release survived into the next poll");
+        }
+    }
+    Reset(); sink.BeginHotkeyCapture(); Key(0x11,0);
+    dispatchToSink=false; Check(!Key(0x11,2),"no-sink release leaked");
+    dispatchToSink=true; sink.BeginHotkeyCapture(); Key(0x11,0);
+    Check(settings.saves==2,"no-sink tail did not retire captured release");
+    for(auto modifier:{0x1DU,0x2AU,0x38U}) {
+      for(bool captureOwned:{false,true}) {
+        for(bool stopSink:{false,true}) {
+            for(bool releaseInConsole:{false,true}) {
+                Reset();
+                if(captureOwned) { sink.BeginHotkeyCapture(); Key(modifier,0); Key(0x41,0); Key(0x41,2); }
+                else { bcn::native_ui::open=false; Key(modifier,0); }
+                RE::UI::console=true; dispatchToSink=!stopSink;
+                Check(Key(0x29,0)&&Key(0x29,2),"console tilde edges were consumed");
+                if(releaseInConsole) Check(Key(modifier,2),"console modifier release was consumed");
+                RE::UI::console=false; dispatchToSink=true; bcn::native_ui::open=true;
+                sink.BeginHotkeyCapture();
+                if(!releaseInConsole) Key(modifier,1);
+                Key(0x11,0);
+                const auto chord=settings.values.openHotkey;
+                const bool present=modifier==0x1D?chord.ctrl:modifier==0x2A?chord.shift:chord.alt;
+                Check(present==!releaseInConsole,"console observation lost held modifier or retained released modifier");
+                Key(0x11,2); Key(modifier,2);
+                sink.BeginHotkeyCapture(); Key(0x1E,0);
+                const auto next=settings.values.openHotkey;
+                Check(!next.ctrl&&!next.shift&&!next.alt,"post-console capture-owned release did not retire modifier");
+            }
+        }
+      }
+    }
+    std::cout<<"PASS "<<checks<<" real capture/filter pipeline checks\n";
+} catch(const std::exception& error) { std::cerr<<error.what()<<'\n'; return 1; }
