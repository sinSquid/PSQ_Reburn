+// The upstream filter, capture entry, keyboard dispatch and capture state
+// methods are extracted unchanged. Only engine/UI/settings boundaries are fake.
+namespace RE {
+enum class INPUT_DEVICE { kKeyboard, kMouse, kGamepad };
+enum class INPUT_EVENT_TYPE { kButton, kMouseMove };
+enum class BSEventNotifyControl { kContinue };
+struct ButtonEvent;
+struct InputEvent {
+    INPUT_DEVICE device{INPUT_DEVICE::kKeyboard};
+    INPUT_EVENT_TYPE type{INPUT_EVENT_TYPE::kButton};
+    InputEvent* next{};
+    ButtonEvent* AsButtonEvent();
+    INPUT_DEVICE GetDevice() const { return device; }
+    INPUT_EVENT_TYPE GetEventType() const { return type; }
+};
+struct ButtonEvent : InputEvent {
+    std::uint32_t id{};
+    int edge{};
+    std::uint32_t GetIDCode() const { return id; }
+    bool IsPressed() const { return edge != 2; }
+    bool IsDown() const { return edge == 0; }
+    bool IsUp() const { return edge == 2; }
+};
+ButtonEvent* InputEvent::AsButtonEvent() { return type == INPUT_EVENT_TYPE::kButton ? static_cast<ButtonEvent*>(this) : nullptr; }
+struct BSWin32MouseDevice { enum class Key { kLeftButton=0, kRightButton=1, kWheelUp=8, kWheelDown=9 }; };
+struct Console { static constexpr auto MENU_NAME="Console"; };
+struct UI {
+    static inline bool console{};
+    static UI* GetSingleton() { static UI value; return &value; }
+    bool IsMenuOpen(const char*) const { return console; }
+};
+struct ControlMap {
+    enum class InputContextID { kGameplay, kMenuMode };
+    static ControlMap* GetSingleton() { static ControlMap value; return &value; }
+    unsigned GetMappedKey(const char*, INPUT_DEVICE, InputContextID context) const { return context == InputContextID::kGameplay ? 0x12 : 1; }
+};
+template<class T> struct BSTEventSource {};
+}
+namespace REL {
+template<class T> struct Relocation {
+    T* callback{};
+    template<class... Args> decltype(auto) operator()(Args&&... args) const {
+        return callback(std::forward<Args>(args)...);
+    }
+};
+}
+namespace bcn {
+namespace frame_tasks { void OnInputTick() {} }
+namespace native_ui {
+bool open{true}, typing{};
+unsigned textEvents{}, navigationEvents{}, actions{}, escapes{}, toggles{};
+bool IsOpen() { return open; }
+bool WantsTextInput() { return typing; }
+void SetMenuActionHeld(bool) {}
+void SubmitActivate() { ++actions; }
+void SubmitCancel() { ++actions; }
+void SubmitEscape() { ++escapes; }
